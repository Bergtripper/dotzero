                    <span className="text-[10px] text-[#F7B801] font-bold">
                      {node.tag}
                    </span>
                  </div>

                  <h3 className="text-sm font-bold text-white mb-1 uppercase">
                    {node.title[language]}
                  </h3>
                  <p className="text-xs text-zinc-400 font-sans leading-relaxed">
                    {node.desc[language]}
                  </p>
                </div>

                <div className="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-[10px] text-zinc-500">
                  <span>STATUS: RUNNING</span>
                  <span className="w-2 h-2 rounded-full bg-emerald-400" />
                </div>
              </div>
            ))}
          </div>
        </div>

      </main>
    </div>
  );
};

export const MusaStudio = ModulorStudio;
